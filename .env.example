# Token secret du bot Discord
DISCORD_TOKEN=

# ID de l'application Discord
CLIENT_ID=

# Optionnel : serveur de développement pour un déploiement immédiat des commandes
GUILD_ID=

# development | test | production
NODE_ENV=development

# Serveur HTTP de santé interne
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3000
